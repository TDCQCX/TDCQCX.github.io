<meta http-equiv="content-type" content="text/html; charset=utf-8">
<meta name="x5-fullscreen" content="true">
<meta name="full-screen" content="yes">
<meta name="theme-color" content="#317EFB" />
<!-- 允许双指缩放 (无障碍: 原 user-scalable=0 会禁用缩放) -->
<meta content="width=device-width, initial-scale=1.0, maximum-scale=5.0" name="viewport">
<!-- SEO: 规范链接, 避免 /path/ 与 /path/index.html 被当成两个页面重复收录 -->
<link rel="canonical" href="<%= config.url.replace(/\/+$/, '') %><%= url_for(page.path || '/') %>">
<%- theme.open_graph ? open_graph() : ''%>
<% if(page.keywords){%>
    <meta name="keywords" content="<%= page.keywords %>">
<%}else if(config.keywords){%>
    <meta name="keywords" content="<%= config.keywords %>">
<%}%>
<%# 首页补齐分享卡片所需字段 (主题 open_graph 不含 image/description) %>
<% if(is_home()){ %>
    <meta name="description" content="<%= config.description %>">
    <meta property="og:image" content="<%= config.url.replace(/\/+$/, '') + url_for(theme.favicon.logo || '/img/favicon.svg') %>">
    <meta property="og:description" content="<%= config.description %>">
    <meta name="twitter:title" content="<%= config.title %>">
    <meta name="twitter:description" content="<%= config.description %>">
    <meta name="twitter:image" content="<%= config.url.replace(/\/+$/, '') + url_for(theme.favicon.logo || '/img/favicon.svg') %>">
<% } %>
<%# SEO: 文章页输出 JSON-LD 结构化数据, 便于搜索引擎生成富摘要 %>
<% if(is_post()){ %>
<script type="application/ld+json">
<%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": page.title,
    "datePublished": page.date ? page.date.toISOString() : undefined,
    "dateModified": (page.updated || page.date) ? (page.updated || page.date).toISOString() : undefined,
    "author": { "@type": "Person", "name": config.author },
    "publisher": { "@type": "Organization", "name": config.title },
    "mainEntityOfPage": config.url.replace(/\/+$/, '') + url_for(page.path || '/'),
    "image": config.url.replace(/\/+$/, '') + url_for(page.cover || theme.favicon.logo || '/img/favicon.svg')
}) %>
</script>
<% } %>

<%- tag("title", !!page.title ? page.title : config.title) %>

<!-- Favicon -->
<% if(theme.favicon.icon16){%>
    <%- tag("link", {
        href: url_for(theme.favicon.icon16) +'?v='+ theme.version,
        rel: "icon",
        type: "image/png",
        sizes: "16x16"
    }) %>
<%}%>
<% if(theme.favicon.icon32){%>
    <%- tag("link", {
        href: url_for(theme.favicon.icon32) +'?v='+ theme.version, 
        rel: "icon",
        type: "image/png",
        sizes: "32x32"
    }) %>
<%}%>
<% if(theme.favicon.appleTouchIcon || theme.favicon.apple_touch_icon){%>
    <%- tag("link", {
        href: url_for(theme.favicon.appleTouchIcon || theme.favicon.apple_touch_icon) +'?v='+ theme.version,
        rel: "apple-touch-icon",
        sizes: "180x180"
    }) %>
<%}%>
<% if(theme.favicon.webmanifest){%>
    <%- tag("link", {
        href: url_for(theme.favicon.webmanifest),
        rel: "manifest"
    }) %>
<%}%>

<!-- Plugin -->
<%- partial('../_third-party/plugin',{ loadtype: 'css' }) %>

<!-- Icon -->
<% if(theme.assets.icons.css) { %>
    <%- css(theme.assets.icons.css) %>
<% } %>
<% if(theme.assets.icons.js) { %>
    <%- js(theme.assets.icons.js) %>
<% } %>

<!-- Variable -->
<%- async_config() %>
<%- page_config() %>

<!-- Theme mode css -->
<link data-swup-theme rel="stylesheet" href="<%= url_for('css/index.css') %>?v=<%= theme.version %>" id="trm-switch-style">
<script>
    let defaultMode = ASYNC_CONFIG.theme.default !=='auto' ?  ASYNC_CONFIG.theme.default : (window.matchMedia("(prefers-color-scheme: light)").matches ? 'style-light' : 'style-dark')
    let catchMode = localStorage.getItem('theme-mode') || defaultMode;
    let type = catchMode === 'style-dark' ? 'add' : 'remove';
    document.documentElement.classList[type]('dark')
</script>

<!-- CDN -->
<%- partial('../_third-party/cdn',{ cdntype: 'head' }) %>

<!-- Site Analytics -->
<%- partial(theme.layout.analytics) %>