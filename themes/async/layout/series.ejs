<%#
  系列入口页模板
  由 scripts/series.js 的 seriesPageGenerator 提供数据：
    page.series_title / series_subtitle / series_intro / series_extra / chapters / total
  这样一个多章节系列只占首页与归档的一个位置，读者从这里进入各章。
%>
<% let banner = page.banner || {}; %>
<%- partial(theme.layout.main,  {
    banner: partial(theme.layout.banner,  {
        ...theme.banner.default,
        banner_title: page.series_title,
        banner_text: page.series_subtitle,
        ...banner
    }),
    content: (function(){
        let html = ''

        // 导语
        if (page.series_intro) {
            html += '<div class="row trm-scroll-animation" style="margin-bottom: var(--card-bottom-card);">'
                 +  '<div class="col-lg-12"><blockquote>' + page.series_intro + '</blockquote></div></div>'
        }

        // 章节列表
        html += '<div class="row">'
             +  '<div class="col-lg-12"><h5 class="trm-title-with-divider">章节目录'
             +  '<span data-number="01"></span></h5></div>'

        const chapters = page.chapters || []
        chapters.forEach(function(ch, i){
            const no = ch.order !== null && ch.order !== undefined ? ch.order : (i + 1)
            const num = (no < 10 ? '0' : '') + no
            html += '<div class="col-lg-12">'
                 +  '<a href="' + url_for(ch.path) + '" class="trm-anima-link">'
                 +  '<div class="trm-card trm-scroll-animation trm-p-20" style="margin-bottom:12px;">'
                 +  '<div style="display:flex;align-items:baseline;gap:12px;">'
                 +  '<span class="trm-accent-color" style="font-weight:700;font-size:1.1rem;min-width:2.2em;">' + num + '</span>'
                 +  '<span style="flex:1;">'
                 +  '<h6 class="trm-mb-10">' + ch.title + '</h6>'
                 +  (ch.desc ? '<div class="trm-label trm-label-light">' + ch.desc + '</div>' : '')
                 +  '</span>'
                 +  icon(theme.icons.next, 'arrow-right')
                 +  '</div></div></a></div>'
        })

        html += '</div>'

        // 附录/补充资源
        if (Array.isArray(page.series_extra) && page.series_extra.length) {
            html += '<div class="row"><div class="col-lg-12">'
                 +  '<h5 class="trm-title-with-divider">附录<span data-number="02"></span></h5>'
                 +  '</div>'
            page.series_extra.forEach(function(it){
                html += '<div class="col-lg-6">'
                     +  '<a href="' + url_for(it.path) + '" class="trm-anima-link">'
                     +  '<div class="trm-card trm-scroll-animation trm-p-20" style="margin-bottom:12px;">'
                     +  '<h6 class="trm-mb-10">' + it.title + '</h6>'
                     +  (it.desc ? '<div class="trm-label trm-label-light">' + it.desc + '</div>' : '')
                     +  '</div></a></div>'
            })
            html += '</div>'
        }

        return html
    })()
}) %>
