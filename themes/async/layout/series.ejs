<%#
  单个系列详情页 /<key>/
  数据由 scripts/series.js 提供: chapters / series_extra / series_title ...
  布局: 左侧编号 + 标题 + 一句话描述, 右侧箭头; 附录单列一组。
%>
<% let banner = page.banner || {}; %>
<%- partial(theme.layout.main,  {
    banner: partial(theme.layout.banner,  {
        ...theme.banner.default,
        banner_title: page.series_title,
        banner_text: page.series_subtitle,
        ...banner
    }),
    content: (function(){
        let html = ''

        // 返回总览 + 计数
        html += '<div class="row trm-mb-20 trm-scroll-animation">'
             +  '<div class="col-lg-12" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">'
             +  '<a href="' + url_for(page.series_index_url) + '" class="trm-label trm-label-color">'
             +  '<i class="iconfont fas fa-arrow-left"></i> ' + __('title.series_back') + '</a>'
             +  '<span class="trm-label trm-label-light">' + __('title.chapter_count').replace('%s', page.total)
             +  (page.series_extra.length ? ' + ' + page.series_extra.length + ' ' + __('title.series_appendix') : '')
             +  '</span></div></div>'

        // 导语
        if (page.series_intro) {
            html += '<div class="row trm-scroll-animation trm-mb-30">'
                 +  '<div class="col-lg-12"><blockquote>' + page.series_intro + '</blockquote></div></div>'
        }

        // 章节
        html += '<div class="row">'
             +  '<div class="col-lg-12"><h5 class="trm-title-with-divider">' + __('title.series_chapters')
             +  '<span data-number="01"></span></h5></div>'

        ;(page.chapters || []).forEach(function(ch){
            const no = ch.order !== null && ch.order !== undefined ? ch.order : 0
            const num = (no < 10 ? '0' : '') + no
            html += '<div class="col-lg-12">'
                 +  '<a href="' + url_for(ch.path) + '" class="trm-anima-link">'
                 +  '<div class="trm-card trm-scroll-animation trm-p-20" style="margin-bottom:10px;">'
                 +  '<div style="display:flex;align-items:center;gap:14px;">'
                 +  '<span class="trm-accent-color" style="font-weight:700;min-width:2.2em;font-size:1.05rem;">' + num + '</span>'
                 +  '<span style="flex:1;min-width:0;">'
                 +  '<h6 class="trm-mb-10" style="margin:0;">' + ch.title + '</h6>'
                 +  (ch.desc ? '<div class="trm-label trm-label-light trm-mt-10">' + ch.desc + '</div>' : '')
                 +  '</span>'
                 +  '<i class="iconfont ' + theme.icons.next + '" style="opacity:.6;"></i>'
                 +  '</div></div></a></div>'
        })
        html += '</div>'

        // 附录
        if (Array.isArray(page.series_extra) && page.series_extra.length) {
            html += '<div class="row trm-mt-40">'
                 +  '<div class="col-lg-12"><h5 class="trm-title-with-divider">' + __('title.series_appendix')
                 +  '<span data-number="02"></span></h5></div>'
            page.series_extra.forEach(function(it, i){
                const num = 'A' + (i + 1)
                html += '<div class="col-lg-6">'
                     +  '<a href="' + url_for(it.path) + '" class="trm-anima-link">'
                     +  '<div class="trm-card trm-scroll-animation trm-p-20" style="margin-bottom:10px;">'
                     +  '<div style="display:flex;align-items:center;gap:12px;">'
                     +  '<span class="trm-accent-color" style="font-weight:700;min-width:2.2em;">' + num + '</span>'
                     +  '<span style="flex:1;min-width:0;">'
                     +  '<h6 style="margin:0;">' + it.title + '</h6>'
                     +  (it.desc ? '<div class="trm-label trm-label-light trm-mt-10">' + it.desc + '</div>' : '')
                     +  '</span></div></div></a></div>'
            })
            html += '</div>'
        }

        return html
    })()
}) %>
